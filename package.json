{
  "name": "human-harness",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "An AI agent on your Mac that works on its own, keeps at a goal for weeks, and gets better as it goes",
  "author": "Gavin Hao",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueTriangleG/human-harness.git"
  },
  "bin": {
    "human-harness": "bin/human-harness.mjs"
  },
  "files": [
    "apps/",
    "bin/",
    "bridge/",
    "config/",
    "docs/",
    "!docs/lang-glossary.md",
    "modules/",
    "!modules/*/tests/",
    "ops/launchd/",
    "personas/",
    "setup",
    "src/",
    "!src/parity/",
    "NOTICE",
    "package.hh.json",
    "package-lock.hh.json"
  ],
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:quiet": "node --test --test-concurrency=3 --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "hhd": "node src/hhd.ts",
    "hh": "node src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "playwright-core": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
