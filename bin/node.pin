# The Node.js HH runs on when the computer's own is older than 24.18 (or missing): nodejs.org's release of this
# version, accepted only with these sha256 sums (the .tar.xz of each, from https://nodejs.org/dist/v<version>/SHASUMS256.txt).
# ./setup reads this file and nothing else for it: to move to another release, change the version and both sums here.
version=24.22.3
darwin-arm64=1d64136c8a43d648d1b3bad10797a4c995b1ca032d2bde8799de43b37f058fe5
darwin-x64=4daeec962855c1a6e66cda398a25037319dc1bbd4a0939188b3547afbbfb6490
