<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- One role's console (read-only, listens on 127.0.0.1:CONSOLE_PORT). Filled in by `hh new` like hhd.plist.template;
     LABEL from launchdLabels(cfg).console, CONSOLE_PORT is the role's own port. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    {{LAUNCHER}}<string>{{NODE}}</string>
    <string>{{CODE}}/src/console/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>{{CODE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HH_CONFIG</key><string>{{HH_CONFIG}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>HH_CONSOLE_PORT</key><string>{{CONSOLE_PORT}}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{LOG_DIR}}/console.out</string>
  <key>StandardErrorPath</key><string>{{LOG_DIR}}/console.err</string>
</dict>
</plist>
