<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- One role's hhd. Filled in by `hh new` (placeholders: LABEL from launchdLabels(cfg).hhd, NODE, CODE = the machine's
     live framework copy, HH_CONFIG, HOME, PATH, LOG_DIR = <stateDir>/logs), then installed in the user's LaunchAgents and
     `launchctl bootstrap gui/<uid> <file>`. Several roles under one user each get their own label. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    {{LAUNCHER}}<string>{{NODE}}</string>
    <string>{{CODE}}/src/hhd.ts</string>
  </array>
  <key>WorkingDirectory</key><string>{{CODE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HH_CONFIG</key><string>{{HH_CONFIG}}</string>
    <key>PATH</key><string>{{PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{LOG_DIR}}/hhd.out</string>
  <key>StandardErrorPath</key><string>{{LOG_DIR}}/hhd.err</string>
</dict>
</plist>
